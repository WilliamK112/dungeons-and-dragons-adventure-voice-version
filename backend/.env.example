# Copy to backend/.env:  cp .env.example .env
# Then run: npm run email:check
# Full walkthrough: SETUP.md

# --- Required ---
# https://resend.com/api-keys
RESEND_API_KEY=

# Magic links + sessions (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
DND_APP_SECRET=change_me_in_production

# Frontend origin (no trailing slash). Production: your Vercel URL.
DND_PUBLIC_APP_URL=http://localhost:5173

# --- Email routing (recommended) ---
# auto = try Resend, then SMTP if Resend cannot deliver (403, etc.)
DND_EMAIL_PROVIDER=auto

# After you verify a domain in Resend — send to most inboxes:
# DND_FROM_EMAIL=noreply@your-verified-domain.com

# --- SMTP fallback (choose ONE provider block; use real passwords) ---

# Gmail (Google App Password, not normal password): see GMAIL-DELIVERY.md
# DND_SMTP_HOST=smtp.gmail.com
# DND_SMTP_USER=you@gmail.com
# DND_SMTP_PASS=
# DND_SMTP_FROM=you@gmail.com

# Tencent QQ: see EMAIL.md
# DND_SMTP_HOST=smtp.qq.com
# DND_SMTP_PORT=465
# DND_SMTP_SECURE=1
# DND_SMTP_USER=you@qq.com
# DND_SMTP_PASS=
# DND_SMTP_FROM=you@qq.com

# Or a single URL:
# DND_SMTP_URL=smtps://user:pass@smtp.example.com:465

DND_CODE_TTL_MIN=15
DND_MAGIC_LINK_TTL_MIN=15

# DND_EMAIL_FALLBACK_ON_RESEND_ERROR=1

# Local dev only — never in production
# DND_DEV_EXPOSE_CODE_IN_API=1

# --- Optional AI / DB ---
GEMINI_API_KEY=
# DND_DB_PATH=
