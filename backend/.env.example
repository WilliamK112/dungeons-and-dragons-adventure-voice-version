# Copy to backend/.env and fill in. Never commit .env.

# --- Email (Resend) ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Optional; defaults to onboarding@resend.dev when RESEND_API_KEY is set.
# DND_FROM_EMAIL=notifications@your-verified-domain.com

# Where the SPA is opened — used in magic-link emails (must match your real site in production).
DND_PUBLIC_APP_URL=http://localhost:5173

# Random secret for JWT-style tokens (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
DND_APP_SECRET=change_me_in_production

DND_CODE_TTL_MIN=15
DND_MAGIC_LINK_TTL_MIN=15

# If Resend returns 403 (wrong recipient) etc., log [EMAIL-FALLBACK] instead of erroring. Default: on in dev, off in production unless set to 1.
# DND_EMAIL_FALLBACK_ON_RESEND_ERROR=1

# auto | resend | smtp — auto tries Resend then SMTP so any inbox can get codes when SMTP is set up.
# DND_EMAIL_PROVIDER=auto

# Optional SMTP (Gmail, SendGrid, etc.) — used when Resend cannot deliver to a recipient.
# DND_SMTP_HOST=smtp.gmail.com
# DND_SMTP_PORT=587
# DND_SMTP_USER=
# DND_SMTP_PASS=
# DND_SMTP_FROM=
# Or: DND_SMTP_URL=smtps://user:pass@host:465

# Local dev: include verification code / magic link in JSON when email cannot be delivered. Never set in production.
# DND_DEV_EXPOSE_CODE_IN_API=1

# --- AI (optional; server-side Gemini / GenAI routes) ---
GEMINI_API_KEY=

# --- Database (optional) ---
# DND_DB_PATH=

# --- TTS / other (see server.mjs) ---
# OPENAI_API_KEY=
# TTS_PROVIDER=
# COSYVOICE_BASE_URL=
