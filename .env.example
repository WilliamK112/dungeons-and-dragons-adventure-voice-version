# Preferred
GEMINI_API_KEY=your_key_here

# Backward-compatible fallback
API_KEY=your_key_here

# Node backend (auth, email verification, optional Gemini proxy, TTS). Local dev: leave unset — Vite proxies /api → http://127.0.0.1:8080
# VITE_BACKEND_URL=https://your-cloud-run-or-api.example.com

# Optional local dev: pre-fill the email field on the login gate (do not commit real addresses)
# VITE_PREFILL_AUTH_EMAIL=you@example.com
